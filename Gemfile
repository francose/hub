source "https://rubygems.org"

# Matches the GitHub Pages build environment. Run `bundle update github-pages`
# to pick up their version bumps.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Ruby 3.4 dropped these from the default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"

gem "webrick"
